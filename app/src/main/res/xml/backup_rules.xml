<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) full-backup config — mirrors data_extraction_rules.xml. Favorites and
   history entries can reflect what a user calculated, converted, or encrypted; that never
   leaves the device to a Nuvexa server, but it's excluded from Google's cloud backup too,
   in keeping with Nuvexa's local-only positioning. Preferences (theme, language, haptics)
   are not sensitive and stay backed up.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
